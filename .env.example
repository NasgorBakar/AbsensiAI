# =====================================================================
# Variabel Lingkungan Produksi (AbsensiAI)
# =====================================================================

# Port server (Otomatis disediakan oleh platform seperti Render/Railway)
PORT=5000

# Mode Lingkungan ('production' untuk live / cloud, 'development' untuk lokal)
ENVIRONMENT=production

# Kunci Rahasia Sesi Flask (Gunakan string acak panjang dan aman)
SECRET_KEY=absensi-ai-production-super-secret-key-change-this-in-prod

# Jam batas kehadiran tepat waktu (Format HH:MM)
BATAS_JAM_MASUK=07:15

# =====================================================================
# Kredensial Firebase Firestore
# =====================================================================
# Pilih salah satu dari metode berikut:
#
# Metode 1 (Sangat Direkomendasikan di Cloud Hosting): 
# Paste seluruh isi teks file serviceAccountKey.json dalam satu baris:
FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-project-id", ...}

# Metode 2: 
# Base64 string dari file serviceAccountKey.json (menghindari issue karakter baris baru):
# FIREBASE_CREDENTIALS_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAgInByb2plY3RfaWQi...

# Metode 3:
# Jalur file lokal (hanya jika file ditaruh di server fisik / VPS):
# FIREBASE_CREDENTIALS=serviceAccountKey.json
